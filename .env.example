# Fichier facultatif pour le développement. Copier en .env à la racine.
# Electron fournit lui-même INJARA_TOKEN et INJARA_DATA_DIR ; les variables déjà définies ne sont pas écrasées.

# Dossier des données locales (base SQLite, CV, compte mail). Défaut hors Electron : ./data
# INJARA_DATA_DIR=

# Agent mail : « real » (défaut, vraie boîte mail) ou « fake » (boîte de démonstration avec 5 CV d'exemple).
# GMAIL_MODE=fake

# Facultatif : un credentials.json Google partagé en développement.
# Sinon, il s'importe depuis l'application (Boîte mail → Gmail) et est rangé dans <données>/secrets/.
# GMAIL_CREDENTIALS_PATH=C:/chemin/vers/credentials.json

# Réglages fins de l'agent (valeurs par défaut)
# GMAIL_POLL_MINUTES=5
# GMAIL_LOOKBACK_DAYS=30
# GMAIL_MAX_RESULTS=500
