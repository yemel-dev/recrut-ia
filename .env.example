# Fichier facultatif pour le développement. Copier en .env à la racine.
# En production, Electron fournit lui-même INJARA_DATA_DIR, INJARA_TOKEN et INJARA_PORT.

# Dossier des données locales (base SQLite, CV). Défaut : ./data
# INJARA_DATA_DIR=

# Agent mail (voir backend/agent/README.md)
GMAIL_MODE=fake
GMAIL_CREDENTIALS_PATH=data/secrets/credentials.json
GMAIL_TOKEN_PATH=data/secrets/token.json
MAIL_ACCOUNT_PATH=data/secrets/account.json
GMAIL_POLL_MINUTES=5
GMAIL_LOOKBACK_DAYS=30
